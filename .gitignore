# ==================== DEPENDENCIES ====================
# Node modules
node_modules/
Frontend/node_modules/
Backend/node_modules/
**/node_modules/

# Package manager files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/
.npm/

# ==================== ENVIRONMENT VARIABLES ====================
# Environment files - NEVER commit these!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
Backend/.env
Frontend/.env
ML Services/**/.env

# Keep example files
!.env.example
!Backend/.env.example
!Frontend/.env.example

# ==================== BUILD & DIST ====================
# React/Vite build output
dist/
dist-ssr/
build/
Frontend/dist/
Frontend/build/

# Production files
*.production

# ==================== UPLOADS & USER DATA ====================
# Uploaded files (medical reports, images, etc.)
uploads/
Backend/uploads/*
!Backend/uploads/.gitkeep

# ==================== LOGS ====================
# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
Backend/logs/
Frontend/logs/

