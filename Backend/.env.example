# ============================================
# Healance AI Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/healance_ai

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRE=30d

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# OpenAI API (for AI Chatbots & Risk Prediction)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API (optional fallback - free tier 1500 req/day at aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq API (primary LLM for Report Analysis - free tier at console.groq.com/keys)
GROQ_API_KEY=

# FDA API (for Medicine Information Bot - Public API, no key required)
FDA_API_KEY=

# Weather API (for Health Forecast)
WEATHER_API_KEY=your-openweathermap-api-key
OPENWEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_UNITS=metric

# Email (Nodemailer - Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Optional: if omitted, ADMIN_EMAIL is used as SMTP auth user
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
ADMIN_EMAIL=agroreach01@gmail.com

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12345678900

# File Uploads
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
